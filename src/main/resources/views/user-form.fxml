<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="said.microgest.controllers.UserController"
           style="-fx-background-color: #ecf0f1;">

    <!-- ============================================================ -->
    <!-- LISTE -->
    <!-- ============================================================ -->

    <VBox fx:id="listPane"
          spacing="15"
          style="-fx-padding: 24;">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Gestion des utilisateurs"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="addButton"
                    text="+ Ajouter un utilisateur"
                    onAction="#handleAdd"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18;"/>
        </HBox>


        <HBox spacing="10">

            <TextField fx:id="searchField"
                       promptText="Rechercher un utilisateur..."
                       HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="roleFilter"
                      promptText="Rôle"
                      prefWidth="150"/>

            <Button text="Réinitialiser"
                    onAction="#resetFilters"/>
        </HBox>


        <TableView fx:id="userTable"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="nomColumn"
                             text="Nom"
                             prefWidth="120"/>

                <TableColumn fx:id="prenomColumn"
                             text="Prénom"
                             prefWidth="120"/>

                <TableColumn fx:id="usernameColumn"
                             text="Nom d'utilisateur"
                             prefWidth="140"/>

                <TableColumn fx:id="emailColumn"
                             text="Email"
                             prefWidth="190"/>

                <TableColumn fx:id="telephoneColumn"
                             text="Téléphone"
                             prefWidth="120"/>

                <TableColumn fx:id="roleColumn"
                             text="Rôle"
                             prefWidth="110"/>

                <TableColumn fx:id="actifColumn"
                             text="Statut"
                             prefWidth="100"/>

            </columns>

        </TableView>


        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <Button fx:id="editButton"
                    text="Modifier"
                    onAction="#handleEdit"
                    disable="true"
                    style="-fx-padding: 8 18 8 18;"/>

            <Button fx:id="toggleActifButton"
                    text="Activer / Désactiver"
                    onAction="#handleToggleActif"
                    disable="true"
                    style="-fx-padding: 8 18 8 18;"/>

            <Button fx:id="deleteButton"
                    text="Supprimer"
                    onAction="#handleDelete"
                    disable="true"
                    style="-fx-background-color: #e74c3c;
                           -fx-text-fill: white;
                           -fx-padding: 8 18 8 18;"/>

        </HBox>


        <HBox alignment="CENTER"
              spacing="15">

            <Button fx:id="prevButton"
                    text="‹ Précédent"
                    onAction="#previousPage"/>

            <Label text="Page"/>

            <Label fx:id="pageLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Label text="/"/>

            <Label fx:id="totalPagesLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Button fx:id="nextButton"
                    text="Suivant ›"
                    onAction="#nextPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Afficher :"/>

            <ComboBox fx:id="sizeCombo"
                      prefWidth="80"/>

            <Label text="Total :"/>

            <Label fx:id="totalRecordsLabel"
                   text="0"
                   style="-fx-font-weight: bold;"/>

        </HBox>

    </VBox>


    <!-- ============================================================ -->
    <!-- FORMULAIRE (popup) -->
    <!-- ============================================================ -->

    <VBox fx:id="formPane"
          visible="false"
          managed="false"
          spacing="16"
          style="-fx-padding: 24; -fx-min-width: 600;">

        <Label text="Gestion d'un utilisateur"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <GridPane hgap="12"
                  vgap="12">

            <columnConstraints>

                <ColumnConstraints minWidth="120"
                                   prefWidth="120"/>

                <ColumnConstraints minWidth="200"
                                   prefWidth="200"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints minWidth="120"
                                   prefWidth="120"/>

                <ColumnConstraints minWidth="200"
                                   prefWidth="200"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <Label text="Nom * :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="nomField"
                       promptText="Nom"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>


            <Label text="Prénom * :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="2"/>

            <TextField fx:id="prenomField"
                       promptText="Prénom"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="3"/>


            <Label text="Nom d'utilisateur * :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="usernameField"
                       promptText="Ex : jdupont"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>


            <Label text="Email * :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="2"/>

            <TextField fx:id="emailField"
                       promptText="email@domaine.com"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="3"/>


            <Label text="Téléphone * :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="telephoneField"
                       promptText="+221 77 123 45 67"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>


            <Label text="Rôle * :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="2"/>

            <ComboBox fx:id="roleCombo"
                      maxWidth="Infinity"
                      promptText="Sélectionner"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="3"/>


            <Label fx:id="passwordLabel"
                   text="Mot de passe * :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <PasswordField fx:id="passwordField"
                           promptText="Mot de passe"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>


            <Label text="Compte actif :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="2"/>

            <CheckBox fx:id="actifCheck"
                      selected="true"
                      GridPane.rowIndex="3"
                      GridPane.columnIndex="3"/>

        </GridPane>


        <Label fx:id="errorLabel"
               style="-fx-text-fill: #e74c3c;
                      -fx-font-size: 12;"/>


        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <Button text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-padding: 6 16 6 16;"/>

            <Button text="Enregistrer"
                    onAction="#handleSave"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 6 16 6 16;"/>

        </HBox>

    </VBox>

</StackPane>