<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="said.microgest.controllers.AdherentController"
           style="-fx-background-color: #ecf0f1;">

    <VBox fx:id="listPane"
          spacing="15"
          style="-fx-padding: 24;">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Gestion des adhérents"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="addButton"
                    text="+ Ajouter un adhérent"
                    onAction="#handleAdd"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18;"/>
        </HBox>


        <HBox spacing="10">

            <TextField fx:id="searchField"
                       promptText="Rechercher un adhérent..."
                       HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="statutFilter"
                      promptText="Statut"
                      prefWidth="150"/>

            <ComboBox fx:id="agenceFilter"
                      promptText="Agence"
                      prefWidth="180"/>

            <Button text="Réinitialiser"
                    onAction="#resetFilters"/>
        </HBox>


        <TableView fx:id="adherentTable"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="numeroColumn"
                             text="N° Adhérent"
                             prefWidth="125"/>

                <TableColumn fx:id="nomColumn"
                             text="Nom"
                             prefWidth="120"/>

                <TableColumn fx:id="prenomColumn"
                             text="Prénom"
                             prefWidth="120"/>

                <TableColumn fx:id="sexeColumn"
                             text="Sexe"
                             prefWidth="70"/>

                <TableColumn fx:id="telephoneColumn"
                             text="Téléphone"
                             prefWidth="130"/>

                <TableColumn fx:id="emailColumn"
                             text="Email"
                             prefWidth="190"/>

                <TableColumn fx:id="adresseColumn"
                             text="Adresse"
                             prefWidth="180"/>

                <TableColumn fx:id="statutColumn"
                             text="Statut"
                             prefWidth="110"/>

                <TableColumn fx:id="agenceColumn"
                             text="Agence"
                             prefWidth="160"/>

            </columns>

        </TableView>


        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <Button fx:id="editButton"
                    text="Modifier"
                    onAction="#handleEdit"
                    disable="true"
                    style="-fx-padding: 8 18 8 18;"/>

            <Button fx:id="deleteButton"
                    text="Supprimer"
                    onAction="#handleDelete"
                    disable="true"
                    style="-fx-background-color: #e74c3c;
                           -fx-text-fill: white;
                           -fx-padding: 8 18 8 18;"/>

            <Button fx:id="toggleStatutButton"
                    text="Changer statut"
                    onAction="#handleToggleStatut"
                    disable="true"
                    style="-fx-padding: 8 18 8 18;"/>

        </HBox>


        <HBox alignment="CENTER"
              spacing="15">

            <Button fx:id="prevButton"
                    text="‹ Précédent"
                    onAction="#previousPage"/>

            <Label text="Page"/>

            <Label fx:id="pageLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Label text="/"/>

            <Label fx:id="totalPagesLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Button fx:id="nextButton"
                    text="Suivant ›"
                    onAction="#nextPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Afficher :"/>

            <ComboBox fx:id="sizeCombo"
                      prefWidth="80"/>

            <Label text="Total :"/>

            <Label fx:id="totalRecordsLabel"
                   text="0"
                   style="-fx-font-weight: bold;"/>

        </HBox>

    </VBox>


    <VBox fx:id="formPane"
          visible="false"
          managed="false"
          spacing="16"
          style="-fx-padding: 24; -fx-min-width: 600;">

        <Label text="Gestion d'un adhérent"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <GridPane hgap="12"
                  vgap="12">

            <columnConstraints>

                <ColumnConstraints minWidth="120"
                                   prefWidth="120"/>

                <ColumnConstraints minWidth="200"
                                   prefWidth="200"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints minWidth="120"
                                   prefWidth="120"/>

                <ColumnConstraints minWidth="200"
                                   prefWidth="200"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <Label text="N° Adhérent :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="numeroField"
                       promptText="Auto-généré"
                       editable="false"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>


            <Label text="Nom * :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="2"/>

            <TextField fx:id="nomField"
                       promptText="Nom"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="3"/>


            <Label text="Prénom * :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="prenomField"
                       promptText="Prénom"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>


            <Label text="Sexe * :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="2"/>

            <ComboBox fx:id="sexeCombo"
                      maxWidth="Infinity"
                      promptText="Sélectionner"
                      GridPane.rowIndex="1"
                      GridPane.columnIndex="3"/>


            <Label text="Date naissance :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="dateNaissancePicker"
                        maxWidth="Infinity"
                        promptText="jj/mm/aaaa"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>


            <Label text="Téléphone * :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="2"/>

            <TextField fx:id="telephoneField"
                       promptText="+221 77 123 45 67"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="3"/>


            <Label text="Email :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="emailField"
                       promptText="email@domaine.com"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="1"/>


            <Label text="Adresse :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="2"/>

            <TextField fx:id="adresseField"
                       promptText="Adresse"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="3"/>


            <Label text="Date adhésion :"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="dateAdhesionPicker"
                        maxWidth="Infinity"
                        promptText="jj/mm/aaaa"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="1"/>


            <Label text="Statut :"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="2"/>

            <ComboBox fx:id="statutCombo"
                      maxWidth="Infinity"
                      promptText="Sélectionner"
                      GridPane.rowIndex="4"
                      GridPane.columnIndex="3"/>


            <Label text="Agence * :"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="0"/>

            <ComboBox fx:id="agenceCombo"
                      maxWidth="Infinity"
                      promptText="Sélectionner une agence"
                      GridPane.rowIndex="5"
                      GridPane.columnIndex="1"
                      GridPane.columnSpan="3"/>

        </GridPane>


        <Label fx:id="errorLabel"
               style="-fx-text-fill: #e74c3c;
                      -fx-font-size: 12;"/>


        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <Button text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-padding: 6 16 6 16;"/>

            <Button text="Enregistrer"
                    onAction="#handleSave"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 6 16 6 16;"/>

        </HBox>

    </VBox>

</StackPane>