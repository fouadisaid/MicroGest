<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="said.microgest.controllers.MainController">

    <!-- Top : En-tête -->
    <top>
        <VBox>
            <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10; -fx-spacing: 15; -fx-alignment: center-left;">

                <Label text="MICROGEST" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="userLabel" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                <Label fx:id="roleLabel" style="-fx-text-fill: #3498db; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                <Button text="Déconnexion" onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Left : Menu -->
    <left>
        <VBox fx:id="menuContainer" spacing="5" style="-fx-padding: 15; -fx-background-color: #ecf0f1; -fx-pref-width: 200;">

            <Label text="MENU" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>

            <Button fx:id="dashboardButton" text="📊 Tableau de bord" onAction="#showDashboard" styleClass="menu-button"/>
            <Button fx:id="adherentsButton" text="👤 Adhérents" onAction="#showAdherents" styleClass="menu-button"/>
            <Button fx:id="operationsButton" text="💰 Opérations" onAction="#showOperations" styleClass="menu-button"/>
            <Button fx:id="pretsButton" text="🏦 Prêts" onAction="#showPrets" styleClass="menu-button"/>
            <Button fx:id="agencesButton" text="🏢 Agences" onAction="#showAgences" styleClass="menu-button"/>
            <Button fx:id="usersButton" text="👥 Utilisateurs" onAction="#showUsers" styleClass="menu-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="MicroGest v1.0" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>

        </VBox>
    </left>

    <!-- Center : Contenu principal -->
    <center>
        <VBox style="-fx-padding: 20; -fx-background-color: #ffffff;">
            <!-- Le contenu sera chargé dynamiquement -->
        </VBox>
    </center>

</BorderPane>