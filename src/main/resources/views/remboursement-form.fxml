<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="said.microgest.controllers.RemboursementController"
           style="-fx-background-color: #ecf0f1;">

    <!-- LISTE -->
    <VBox fx:id="listPane"
          spacing="15"
          style="-fx-padding: 24;">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Historique des remboursements"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="addButton"
                    text="+ Enregistrer un remboursement"
                    onAction="#handleAdd"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18;"/>
        </HBox>


        <HBox spacing="10">

            <TextField fx:id="searchField"
                       promptText="Rechercher par adhérent..."
                       HBox.hgrow="ALWAYS"/>

            <Button text="Réinitialiser"
                    onAction="#resetFilters"/>
        </HBox>


        <TableView fx:id="remboursementTable"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="adherentColumn"
                             text="Adhérent"
                             prefWidth="190"/>

                <TableColumn fx:id="montantPretColumn"
                             text="Montant du prêt"
                             prefWidth="130"/>

                <TableColumn fx:id="montantColumn"
                             text="Montant remboursé"
                             prefWidth="150"/>

                <TableColumn fx:id="echeanceColumn"
                             text="N° Échéance"
                             prefWidth="100"/>

                <TableColumn fx:id="dateColumn"
                             text="Date de paiement"
                             prefWidth="130"/>

                <TableColumn fx:id="montantRestantColumn"
                             text="Restant après"
                             prefWidth="130"/>

                <TableColumn fx:id="statutColumn"
                             text="Statut du prêt"
                             prefWidth="120"/>

                <TableColumn fx:id="modifiableColumn"
                             text="Modifiable"
                             prefWidth="90"/>

            </columns>

        </TableView>


        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <Button fx:id="editButton"
                    text="Modifier"
                    onAction="#handleEdit"
                    disable="true"
                    style="-fx-padding: 8 18 8 18;"/>

        </HBox>


        <HBox alignment="CENTER"
              spacing="15">

            <Button fx:id="prevButton"
                    text="‹ Précédent"
                    onAction="#previousPage"/>

            <Label text="Page"/>

            <Label fx:id="pageLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Label text="/"/>

            <Label fx:id="totalPagesLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Button fx:id="nextButton"
                    text="Suivant ›"
                    onAction="#nextPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Afficher :"/>

            <ComboBox fx:id="sizeCombo"
                      prefWidth="80"/>

            <Label text="Total :"/>

            <Label fx:id="totalRecordsLabel"
                   text="0"
                   style="-fx-font-weight: bold;"/>

        </HBox>

    </VBox>



    <!-- FORMULAIRE (popup) -->

    <VBox fx:id="formPane"
          visible="false"
          managed="false"
          spacing="16"
          style="-fx-padding: 24; -fx-min-width: 500;">

        <Label fx:id="formTitleLabel"
               text="Enregistrer un remboursement"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <GridPane hgap="12"
                  vgap="12">

            <columnConstraints>

                <ColumnConstraints minWidth="140"
                                   prefWidth="140"/>

                <ColumnConstraints minWidth="260"
                                   prefWidth="260"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <Label text="Prêt * :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <ComboBox fx:id="pretCombo"
                      maxWidth="Infinity"
                      promptText="Sélectionner un prêt validé"
                      GridPane.rowIndex="0"
                      GridPane.columnIndex="1"/>


            <Label text="Montant restant :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <Label fx:id="montantRestantLabel"
                   text="Montant restant : —"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>


            <Label text="Montant versé * :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <TextField fx:id="montantField"
                       promptText="Montant en FCFA"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>


            <Label text="Date de paiement :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="datePaiementPicker"
                        maxWidth="Infinity"
                        promptText="jj/mm/aaaa"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="1"/>

        </GridPane>


        <Label fx:id="errorLabel"
               style="-fx-text-fill: #e74c3c;
                      -fx-font-size: 12;"/>


        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <Button text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-padding: 6 16 6 16;"/>

            <Button text="Enregistrer"
                    onAction="#handleSave"
                    style="-fx-background-color: #27ae60;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 6 16 6 16;"/>

        </HBox>

    </VBox>

</StackPane>