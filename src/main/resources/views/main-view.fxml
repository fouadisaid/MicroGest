<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="said.microgest.controllers.MainController"
            prefWidth="1200"
            prefHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: #2c3e50; -fx-padding: 14 20 14 20;">

            <Label text="MicroGest"
                   style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>

            <Label fx:id="roleLabel"
                   style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>

            <Button fx:id="parametrageButton"
                    text="⚙️ Paramètres"
                    onAction="#showParametrage"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16 6 16;"/>

            <Button text="Déconnexion"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16 6 16;"/>

        </HBox>
    </top>

    <left>
        <VBox fx:id="menuContainer"
              spacing="8"
              prefWidth="190"
              style="-fx-background-color: #34495e; -fx-padding: 15;">

            <Label text="MENU"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 12; -fx-font-weight: bold;"/>

            <Separator/>

            <Button fx:id="dashboardButton"
                    text="🏠 Tableau de bord"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="adherentsButton"
                    text="👤 Adhérents"
                    onAction="#showAdherents"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="operationsButton"
                    text="💰 Opérations"
                    onAction="#showOperations"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="epargnesButton"
                    text="🏦 Épargnes"
                    onAction="#showEpargnes"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="pretsButton"
                    text="💳 Prêts"
                    onAction="#showPrets"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="remboursementsButton"
                    text="🔄 Remboursements"
                    onAction="#showRemboursements"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="agencesButton"
                    text="🏢 Agences"
                    onAction="#showAgences"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

            <Button fx:id="usersButton"
                    text="👥 Utilisateurs"
                    onAction="#showUsers"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10;"/>

        </VBox>
    </left>

    <center>
        <StackPane style="-fx-background-color: #ecf0f1; -fx-padding: 15;">

            <Label text="Bienvenue dans MicroGest"
                   style="-fx-font-size: 24; -fx-text-fill: #7f8c8d;"/>

        </StackPane>
    </center>

</BorderPane>