<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="said.microgest.controllers.EpargneController"
           style="-fx-background-color: #ecf0f1;">

    <!-- ============================================================ -->
    <!-- LISTE -->
    <!-- ============================================================ -->

    <VBox fx:id="listPane"
          spacing="15"
          style="-fx-padding: 24;">

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <Label text="Consultation des épargnes"
                   style="-fx-font-size: 22; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="totalLabel"
                   text="Total épargné : 0 FCFA"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </HBox>


        <HBox spacing="10">

            <TextField fx:id="searchField"
                       promptText="Rechercher un adhérent..."
                       HBox.hgrow="ALWAYS"/>

            <Button text="Réinitialiser"
                    onAction="#resetFilters"/>
        </HBox>


        <TableView fx:id="epargneTable"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="adherentColumn"
                             text="Adhérent"
                             prefWidth="220"/>

                <TableColumn fx:id="numeroColumn"
                             text="N° Adhérent"
                             prefWidth="130"/>

                <TableColumn fx:id="soldeColumn"
                             text="Solde"
                             prefWidth="150"/>

                <TableColumn fx:id="dateColumn"
                             text="Date d'ouverture"
                             prefWidth="140"/>

            </columns>

        </TableView>


        <HBox alignment="CENTER_RIGHT"
              spacing="10">

            <Button fx:id="detailButton"
                    text="Détails"
                    onAction="#handleDetail"
                    disable="true"
                    style="-fx-background-color: #2980b9;
                           -fx-text-fill: white;
                           -fx-padding: 8 18 8 18;"/>

        </HBox>


        <HBox alignment="CENTER"
              spacing="15">

            <Button fx:id="prevButton"
                    text="‹ Précédent"
                    onAction="#previousPage"/>

            <Label text="Page"/>

            <Label fx:id="pageLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Label text="/"/>

            <Label fx:id="totalPagesLabel"
                   text="1"
                   style="-fx-font-weight: bold;"/>

            <Button fx:id="nextButton"
                    text="Suivant ›"
                    onAction="#nextPage"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Afficher :"/>

            <ComboBox fx:id="sizeCombo"
                      prefWidth="80"/>

            <Label text="Total :"/>

            <Label fx:id="totalRecordsLabel"
                   text="0"
                   style="-fx-font-weight: bold;"/>

        </HBox>

    </VBox>


    <!-- ============================================================ -->
    <!-- DETAIL (popup, lecture seule) -->
    <!-- ============================================================ -->

    <VBox fx:id="detailPane"
          visible="false"
          managed="false"
          spacing="16"
          style="-fx-padding: 24; -fx-min-width: 600;">

        <Label text="Détail du compte épargne"
               style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <GridPane hgap="12"
                  vgap="10">

            <columnConstraints>

                <ColumnConstraints minWidth="140"
                                   prefWidth="140"/>

                <ColumnConstraints minWidth="300"
                                   prefWidth="300"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <Label text="Adhérent :"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <Label fx:id="detailAdherentLabel"
                   text="—"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>


            <Label text="N° Adhérent :"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <Label fx:id="detailNumeroLabel"
                   text="—"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>


            <Label text="Date d'ouverture :"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <Label fx:id="detailDateLabel"
                   text="—"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>


            <Label text="Solde actuel :"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <Label fx:id="detailSoldeLabel"
                   text="—"
                   style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #27ae60;"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        </GridPane>


        <Label text="Historique des opérations"
               style="-fx-font-size: 16; -fx-font-weight: bold;"/>

        <TableView fx:id="operationTable"
                   VBox.vgrow="ALWAYS"
                   minHeight="250">

            <columns>

                <TableColumn fx:id="opTypeColumn"
                             text="Type"
                             prefWidth="100"/>

                <TableColumn fx:id="opMontantColumn"
                             text="Montant"
                             prefWidth="150"/>

                <TableColumn fx:id="opDateColumn"
                             text="Date"
                             prefWidth="150"/>

                <TableColumn fx:id="opObservationColumn"
                             text="Observation"
                             prefWidth="200"/>

            </columns>

        </TableView>


        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <Button fx:id="envoyerReleveButton"
                    text="Envoyer le relevé par email"
                    onAction="#handleEnvoyerReleve"
                    disable="true"
                    style="-fx-background-color: #2980b9;
                           -fx-text-fill: white;
                           -fx-padding: 6 16 6 16;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Fermer"
                    onAction="#handleCloseDetail"
                    style="-fx-padding: 6 16 6 16;"/>

        </HBox>

    </VBox>

</StackPane>