<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="said.microgest.controllers.EpargneController"
      stylesheets="/css/application.css">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="💰 Gestion des Épargnes" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Barre d'outils -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="totalEpargneLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📊 Calculer intérêts" onAction="#handleCalculerInterets" styleClass="btn-primary"/>
        <Button text="➕ Ajouter intérêts" onAction="#handleAjouterInterets" styleClass="btn-success"/>
    </HBox>

    <TableView fx:id="epargneTable" VBox.vgrow="ALWAYS" prefHeight="250">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="40"/>
            <TableColumn fx:id="soldeColumn" text="Solde" prefWidth="150"/>
            <TableColumn fx:id="dateOuvertureColumn" text="Date d'ouverture" prefWidth="150"/>
            <TableColumn fx:id="adherentColumn" text="Adhérent" prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <TitledPane text="Formulaire Épargne" expanded="false">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Adhérent :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="adherentCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

            <Label text="Solde initial :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="soldeField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>

            <Label text="Date d'ouverture :" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dateOuverturePicker" GridPane.columnIndex="3" GridPane.rowIndex="1" prefWidth="200"/>

            <Label fx:id="interetsLabel" text="Intérêts estimés : -" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="4" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="4">
                <Button fx:id="saveButton" text="💾 Enregistrer" onAction="#handleSave" styleClass="btn-success"/>
                <Button fx:id="cancelButton" text="❌ Annuler" onAction="#handleCancel" styleClass="btn-secondary"/>
                <Button fx:id="deleteButton" text="🗑️ Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
            </HBox>
        </GridPane>
    </TitledPane>
</VBox>